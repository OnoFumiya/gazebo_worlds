<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- TODO: allow xacro -->
  <xacro:arg name="fast_physics" default="true" />
  <xacro:arg name="trofast_knob" default="true" />
  <xacro:arg name="highrtf" default="false" />

  <world name='robot_cafe_arena'>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
        filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>


    <!--  -->
    <plugin
        filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">
    </plugin>
    <!--  -->

    <scene>
      <grid>false</grid>
    </scene>

    <physics name="1ms" type="ignored">
        <max_step_size>0.004</max_step_size>
        <real_time_update_rate>250</real_time_update_rate>
        <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose relative_to=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
          <range>1000</range>
          <constant>0.9</constant>
          <linear>0.01</linear>
          <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--gravity-->
    <gravity>0 0 -9.8</gravity>

    <!-- Import models -->
    <!-- Global Models -->
    <include>
      <name>multi_floor_cafeteria_floor</name>
      <static>1</static>
      <uri>model://multi_floor_cafeteria/floor</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>multi_floor_cafeteria_frame</name>
      <static>1</static>
      <uri>model://multi_floor_cafeteria/frame</uri>
      <pose relative_to=''>0 0 0 0 0 0</pose>
    </include>
    <!-- Global Models -->

    <!-- Optional Models -->
    <!-- <include>
      <name>elevator</name>
      <uri>model://elevator_set</uri>
      <static>1</static>
      <pose relative_to=''>-2.0 -6.0 0 0 0 -1.57</pose>
    </include> -->
    <include>
      <name>elevator_main</name>
      <uri>model://elevator_set_old/main</uri>
      <static>1</static>
      <pose relative_to=''>-2.0 -6.0 0 0 0 -1.57</pose>
    </include>
    <include>
      <name>elevator_inner_door_left</name>
      <uri>model://elevator_set_old/inner_door_left</uri>
      <static>1</static>
