<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="elevator_set">
    
    <!-- ベース（固定部分） -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>10</iyy><iyz>0</iyz>
          <izz>10</izz>
        </inertia>
      </inertial>
    </link>

    <!-- エレベーターの箱 -->
    <link name="cabin">
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1</iyy><iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
      <collision name="cabin_collision">
        <geometry>
          <box>
            <size>1.5 1.5 2.0</size>
          </box>
        </geometry>
      </collision>
      <visual name="cabin_visual">
        <geometry>
          <box>
            <size>1.5 1.5 2.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ドア -->
    <link name="door">
      <pose>0.7 0 0.5 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1</iyy><iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <collision name="door_collision">
        <geometry>
          <box>
            <size>0.1 0.8 1.8</size>
          </box>
        </geometry>
      </collision>
      <visual name="door_visual">
        <geometry>
          <box>
            <size>0.1 0.8 1.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joint 1: 昇降用 (Z軸方向のスライド) -->
    <joint name="elevator_lift_joint" type="prismatic">
      <parent>base_link</parent>
      <child>cabin</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>5.0</upper> <!-- 最大5m上昇 -->
          <effort>10000</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Joint 2: ドア開閉用 (Y軸方向のスライド) -->
    <joint name="door_joint" type="prismatic">
      <parent>cabin</parent>
      <child>door</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.8</upper> <!-- ドアのスライド量 -->
          <effort>500</effort>
          <velocity>0.5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ============================================================ -->
    <!-- 標準プラグインによる自動制御設定                             -->
    <!-- ============================================================ -->

    <!-- 昇降用コントローラ -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>elevator_lift_joint</joint_name>
      <topic>/elevator/cmd_lift</topic>
      <p_gain>10000</p_gain>
      <i_gain>100</i_gain>
      <d_gain>500</d_gain>
      <i_max>1000</i_max>
      <i_min>-1000</i_min>
      <!-- 初期設定ターゲット位置（例: 5m上へ） -->
      <cmd_offset>0.0</cmd_offset>
      <initial_position>5.0</initial_position>
    </plugin>

    <!-- ドア開閉用コントローラ -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>door_joint</joint_name>
      <topic>/elevator/cmd_door</topic>
      <p_gain>1000</p_gain>
      <i_gain>10</i_gain>
      <d_gain>100</d_gain>
      <!-- 初期設定ターゲット位置（例: 昇降後に開く動作を模倣） -->
      <initial_position>0.8</initial_position>
    </plugin>

  </model>
</sdf>